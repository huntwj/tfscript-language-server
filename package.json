{
  "name": "tfscript-language-server-workspace",
  "private": true,
  "description": "Workspace root for tfscript, TinyFugue's macro language: the analysis core and the language server.",
  "license": "MIT",
  "author": "Wil Hunt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huntwj/tfscript-language-server.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/core",
    "packages/server",
    "packages/cli"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:corpus-live": "npm run build && node scripts/check-corpus-live.js",
    "test:format-live": "npm run build && node scripts/check-format-live.js",
    "docs:rules": "npm run build && node scripts/generate-rule-docs.js",
    "bundle:claude-code": "node scripts/bundle-claude-code.js",
    "bundle:claude-code:check": "node scripts/bundle-claude-code.js --check"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "esbuild": "0.28.2",
    "typescript": "^5.5.3",
    "vitest": "^5.0.3"
  }
}
