{
  "name": "tfscript-language-server",
  "version": "0.2.0",
  "description": "Language server for tfscript, TinyFugue's macro language.",
  "license": "MIT",
  "author": "Wil Hunt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huntwj/tfscript-language-server.git"
  },
  "bugs": {
    "url": "https://github.com/huntwj/tfscript-language-server/issues"
  },
  "keywords": ["tinyfugue", "tf", "tfscript", "language-server", "lsp", "mud"],
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/server.js",
  "bin": {
    "tfscript-language-server": "dist/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:corpus-live": "npm run build && node scripts/check-corpus-live.js",
    "docs:rules": "npm run build && node scripts/generate-rule-docs.js"
  },
  "dependencies": {
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.5.3",
    "vitest": "^5.0.3"
  }
}
